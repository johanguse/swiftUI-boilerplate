// Copy this file to APIConfig.swift (which is gitignored) and fill in your values.
//
// Python FastAPI backend:
//   baseURL  = "https://api.yourapp.com"
//   apiPrefix = "/api/v1"
//   Auth endpoints: /auth/sign-in/email, /auth/sign-up/email, /auth/sign-out, /auth/session
//
// Bun/Hono backend:
//   baseURL   = "https://api.yourapp.com"
//   apiPrefix = ""
//   Change authPath("/sign-in/email") → "/auth/jwt/login"
//   Change authPath("/sign-up/email") → "/auth/register"

enum APIConfig {
    // Base URL of your backend — no trailing slash.
    static let baseURL = "https://your-api.example.com"

    // Path prefix for all API routes.
    // Python FastAPI: "/api/v1"   Bun/Hono: ""
    static let apiPrefix = "/api/v1"

    static func authPath(_ endpoint: String) -> String { apiPrefix + "/auth" + endpoint }
    static func apiPath(_ endpoint: String) -> String { apiPrefix + endpoint }
}
